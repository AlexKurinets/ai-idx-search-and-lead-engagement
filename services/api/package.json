{
  "name": "idx-api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API and workers: RESO replication, outbox relay, search, leads, messaging and the agent console API",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@opensearch-project/opensearch": "2.13.0",
    "@temporalio/client": "1.13.1",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.2",
    "kafkajs": "2.2.4",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.4",
    "typescript": "5.9.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": ["<rootDir>/test"],
        "testMatch": ["**/*.spec.ts"],
        "testPathIgnorePatterns": ["int.spec.ts"]
      },
      {
        "displayName": "integration",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": ["<rootDir>/test"],
        "testMatch": ["**/*.int.spec.ts"]
      }
    ]
  }
}
