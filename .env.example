# Host ports (defaults avoid the usual 3000/5432/8000)
WEB_PORT=3100
API_PORT=4100
AI_PORT=8100
MLS_PORT=8110
PG_PORT=5442
REDIS_PORT=6390
OPENSEARCH_PORT=9210
KAFKA_PORT=19093
TEMPORAL_PORT=7243
TEMPORAL_UI_PORT=8243

# Model provider: offline (deterministic, default) or openai
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Dev-only secrets; change for anything shared
INTERNAL_TOKEN=dev-internal-token
JWT_SECRET=dev-jwt-secret-change-me
SMS_AUTH_TOKEN=dev-sms-auth-token
MLS_CLIENT_SECRET=dev-mls-secret

# How often the synthetic MLS changes and the replicator polls
SIM_TICK_SECONDS=20
REPLICATION_INTERVAL_MS=15000
RECONCILE_INTERVAL_MS=600000
SEED_LIVE_LEADS=120
